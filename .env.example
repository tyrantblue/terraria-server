# 复制成 .env 后按需修改；.env 不会进 Git
TZ=Asia/Shanghai

# 事件通知（留空即关闭）。这些只是**默认值**：面板/API 里的
# PUT /api/v1/notifications/settings 会写 control/notify.json 覆盖它们，改完不用重启。
# 飞书自定义机器人：https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# Discord：https://discord.com/api/webhooks/xxxx
# Slack：https://hooks.slack.com/services/xxxx
NOTIFY_WEBHOOK_URL=
# auto | discord | slack | feishu | json | qq | none
NOTIFY_FORMAT=auto
# 逗号分隔的事件白名单，空 = 全部
NOTIFY_EVENTS=

# QQ 频道机器人（NOTIFY_FORMAT=qq 时前三项必填，从 QQ 开放平台管理端获取）
# 官方限制：主动消息默认每个子频道每天 20 条，且要求机器人保持 gateway 连接，
# 所以建议只接低频事件（NOTIFY_EVENTS=log_stalled,schedule_failed,server_error）
NOTIFY_QQ_APP_ID=
NOTIFY_QQ_CLIENT_SECRET=
NOTIFY_QQ_CHANNEL_ID=
NOTIFY_QQ_SANDBOX=0
# 高级：覆盖默认域名（沙箱/自建网关/测试时才需要）
# NOTIFY_QQ_API_BASE=
# NOTIFY_QQ_TOKEN_URL=

# ---- API 安全加固（issue #17）；边缘已有 Access/VPN 时下面都可留默认 ----
# 写操作共享 token：留空 = 关闭；非空时写请求需带 Authorization: Bearer <token>
TERRARIA_API_TOKEN=
# 允许跨域的来源，逗号分隔；生产环境应收敛为面板实际来源，例如
# TERRARIA_CORS_ORIGINS=https://terraria-api.tyrantblue.xyz
TERRARIA_CORS_ORIGINS=*
# 写操作限流（每分钟 / 每客户端；0 = 不限流）
TERRARIA_RATE_LIMIT_ENABLED=1
TERRARIA_RATE_LIMIT_WRITE_PER_MINUTE=120
TERRARIA_RATE_LIMIT_CONSOLE_PER_MINUTE=60
TERRARIA_RATE_LIMIT_RESTART_PER_MINUTE=12

